<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Odak kilidi: kullanıcının seçtiği uygulamalar odak süresince açılınca
         üstte "odaklan" ekranı gösterilir. Kullanım erişimi ve "diğer
         uygulamaların üzerinde göster" iznini kullanıcı sistem ayarlarından
         kendisi verir. Erişilebilirlik hizmeti KULLANILMAZ. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Engellenecek uygulamaları seçebilmek için başlatıcıdaki uygulamalar. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application>
        <service
            android:name="com.gamestudio100.verimlilik_motoru.FocusService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Focus mode chosen by the user: shows a reminder screen over apps the user selected to block until the focus session ends." />
        </service>
    </application>
</manifest>
